# Local fictional adapter only; always denied on Vercel.
SCOUT_DEMO_ENABLED=false
# Vercel server-only customer transport. Remains closed by default.
SCOUT_CUSTOMER_ENABLED=false
SCOUT_CUSTOMER_WORKER_ORIGIN=
SCOUT_CUSTOMER_SERVICE_TOKEN=
# Worker configuration is separate: DB binding, CUSTOMER_ENABLED=false,
# SERVICE_TOKEN, SIL_ORIGIN, SIL_SERVICE_TOKEN, SIL_APP_KEY.
# No resources, app identifiers or credentials are prefilled.
